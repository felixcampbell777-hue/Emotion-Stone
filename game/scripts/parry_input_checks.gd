extends RefCounted
func key(code:int,pressed:bool) -> void:
	var event=InputEventKey.new()
	event.physical_keycode=code
	event.pressed=pressed
	Input.parse_input_event(event)
	Input.flush_buffered_events()
func right_click(game:Control,pressed:bool) -> void:
	var event=InputEventMouseButton.new()
	event.position=game.world_rect.get_center()
	event.global_position=event.position
	event.button_index=MOUSE_BUTTON_RIGHT
	event.pressed=pressed
	Input.parse_input_event(event)
	Input.flush_buffered_events()
func run(test:RefCounted) -> void:
	var game=test.game
	var path="user://parry-input-verification.json"
	game.title_screen.show_menu(path)
	game.title_screen.new_button.pressed.emit()
	game.advance_dialogue()
	game.load_map("coastal_path",Vector2(0,3),true)
	# Let map construction finish before timing the configured draw window.
	await test.frames(4)
	key(KEY_R,true)
	await test.frames(2)
	key(KEY_R,false)
	await test.frames(8)
	right_click(game,true)
	await test.frames(2)
	right_click(game,false)
	test.check(game.player.state=="draw" and game.parry_after_draw,"Right-click during sword draw queues a guard instead of dropping the input")
	await test.frames(ceili(game.player.combat.draw_seconds*60)-6)
	test.check(game.player.state=="parry" and game.player.sword_drawn and game.player.stamina==90 and not game.parry_after_draw,"Queued parry starts once after the full draw and spends 10 stamina")
	await test.frames(65)
	game.player.restore_stamina(100)
	right_click(game,true)
	await test.frames(2)
	right_click(game,false)
	test.check(game.player.state=="parry" and game.player.stamina==90,"Ordinary right-click works after a title New Game transition")
	await test.frames(65)
	game.Save.write(game.save_data(),path)
	game.title_screen.show_menu(path)
	game.title_screen.load_button.pressed.emit()
	game.player.restore_stamina(100)
	key(KEY_F,true)
	await test.frames(2)
	key(KEY_F,false)
	test.check(game.player.state=="parry" and game.player.stamina==90,"Keyboard F works after title Load Saved Game")
	await test.frames(65)
	game.player.set_sword_drawn(false)
	game.player.restore_stamina(100)
	key(KEY_R,true)
	await test.frames(2)
	key(KEY_R,false)
	right_click(game,true)
	await test.frames(2)
	right_click(game,false)
	game.toggle_help()
	await test.frames(3)
	test.check(not game.parry_after_draw,"Opening a menu cancels a queued parry")
	game.toggle_help()
	await test.frames(ceili(game.player.combat.draw_seconds*60)+4)
	test.check(game.player.state=="free" and game.player.stamina==100,"Canceled guard never fires later or spends stamina")
	game.player.restore_stamina(5)
	key(KEY_F,true)
	await test.frames(2)
	key(KEY_F,false)
	test.check(game.player.state=="free" and game.hud_feedback.pulse_remaining>0,"Low-stamina parry gives feedback")
	game.player.restore_stamina(100)
	game.player.begin_attack("heavy")
	key(KEY_F,true)
	await test.frames(2)
	key(KEY_F,false)
	test.check(game.player.state=="heavy" and game.toast.text.contains("Finish the current action"),"A blocked parry explains recovery without canceling the attack")
	game.player.set_sword_drawn(true)
	DirAccess.remove_absolute(path)
