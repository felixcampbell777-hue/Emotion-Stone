extends RefCounted
func run(test:RefCounted) -> void:
	var g=test.game;g.game_mode="world_rise";g.start_new_game(false);g.title_screen.hide();g.set_process(false);g.set_physics_process(false);g.player.set_physics_process(false);g._refresh_simulation()
	var s=g.progression;var a=g.player;var base=g.read_data("res://content/combat.json");var P=g.Progression
	test.check(s.world_rise and not s.has("mana") and not a.water_unlocked and not a.lance_unlocked and not a.dragon_unlocked,"World Rise uses only Strength/Agility/Greatsword and disables all mana abilities")
	s.xp=int(s.definition.level_thresholds[9]);g.apply_skill_stats()
	test.check(a.max_health==109 and is_equal_approx(a.max_stamina,109),"Level ten grants nine one-percent health/stamina increases over the level-one baseline")
	for id in ["iron_body","iron_body","iron_body","stonewall","honed_arms"]:test.check(s.learn(id),"World Rise can invest a point in "+id)
	g.apply_skill_stats();var hp=a.max_health;var damage=a.combat.light.damage;var cost=a.combat.light.stamina_cost
	test.check(is_equal_approx(g.magic_items.incoming_damage(100),84) and damage==roundi(base.light.damage*1.06) and is_equal_approx(cost,base.light.stamina_cost*.94*.85),"Iron Body rank three and Stonewall/Honed Arms apply correct damage, defense and stamina percentages")
	g.apply_skill_stats();test.check(a.max_health==hp and a.combat.light.damage==damage and is_equal_approx(a.combat.light.stamina_cost,cost),"Refreshing World Rise stats never stacks bonuses or heals the player")
	s.restore({"profile":"world_rise","tree_version":4,"xp":int(s.definition.level_thresholds[49]),"learned":[],"greatsword_kills":0})
	for i in range(44):s.learn("iron_body")
	for i in range(5):s.learn("stonewall")
	a.set_meta("rise_fall",-20)
	test.check(g.magic_items.incoming_damage(999999)==999999,"Abyss death bypasses even maximum stacked body-skill defense")
	a.remove_meta("rise_fall");s.learned=[]
	for id in ["swiftfoot","dash","streaming_dash","streaming_dash","streaming_dash","lightstep","lightstep","lightstep","belly_roll","roly_poly","roly_poly","roly_poly","speed_freak"]:s.learn(id)
	g.apply_skill_stats();test.check(a.dash_distance_multiplier==6 and is_equal_approx(a.dash_stamina_multiplier,.05),"Streaming Dash rank three gives +500% distance; Lightstep rank three saves 95% stamina")
	test.check(is_equal_approx(a.walk_speed,2.4*1.02*1.25) and is_equal_approx(a.combat.sprint_drain,base.sprint_drain*.95),"Swiftfoot and Speed-Freak multiply base speed and reduce sprint drain correctly")
	test.check(is_equal_approx(a.combat.dodge.duration,base.dodge.duration/1.75) and is_equal_approx(a.combat.dodge.speed*a.combat.dodge.duration,base.dodge.speed*base.dodge.duration*1.8),"Roly-Poly rank three speeds the roll animation by 75% and increases travel by 80%")
	s.learned=[];s.learn("great_greatsword");test.check(not s.can_learn("charge_thrust"),"Weapon mastery offshoots are locked before fifteen greatsword kills")
	s.greatsword_kills=15;s.learn("charge_thrust");s.learn("fast_thrust");s.learn("basher")
	test.check(not s.can_learn("basher"),"Second Basher rank needs thirty total greatsword kills")
	s.greatsword_kills=45;s.learn("basher");s.learn("basher");test.check(not s.can_learn("devastating_blade"),"Basher rank three alone cannot bypass the four-hundred-kill requirement")
	s.greatsword_kills=400;s.learn("devastating_blade");g.apply_skill_stats()
	test.check(is_equal_approx(load("res://scripts/world_rise_stats.gd").damage_multiplier(g),3.0) and a.thrust_charge_rate==2 and a.combat.thrust_charge.max_seconds==5 and a.combat.thrust_charge.damage_per_second==.15,"Greatsword damage is percentage based; Fast Thrust fills five seconds of 175% power in 2.5 real seconds")
	var path="user://world-rise-stats-verification.json";g.Save.write(g.save_data(),path);var back=g.Save.read(path)
	test.check(not back.is_empty() and g.apply_save(back) and g.progression.greatsword_kills==400 and g.progression.has("devastating_blade"),"New World Rise skill ranks, kill counts and allocations survive strict private save/load")
	var bad=g.progression.snapshot();bad.greatsword_kills=14;test.check(not P.valid(bad),"Strict save validation rejects ranks whose kill requirements are unmet")
	g.progression.restore({"tree_version":3,"xp":8200,"learned":["strength","mana","mana_lance"],"passives":[]});g.apply_skill_stats()
	test.check(g.progression.learned.is_empty() and g.progression.xp==8200 and not a.water_unlocked,"Old World Rise saves retain XP and refund old allocations including removed mana")
	g.toggle_inventory();g.inventory.show_page("level");test.check(g.skill_tree.rise_menu!=null and g.skill_tree.rise_menu.categories.get_child_count()==3 and not a.input_enabled,"Three large System categories open within inventory and freeze simulation")
	g.skill_tree.rise_menu.selected="Greatsword";g.skill_tree.refresh();test.check(g.skill_tree.rise_menu.grid.get_child_count()==6,"Expanded Greatsword category lays out every skill and explicit prerequisites")
	g.inventory.close();DirAccess.remove_absolute(path)
