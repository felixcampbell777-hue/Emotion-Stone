extends RefCounted
func run(test:RefCounted) -> void:
	var g=test.game
	g.title_screen.visible=false;g.game_mode="alpha2";g.alpha2_import_path="user://no-region-import.json";g.start_new_game(false);g.alpha2.mark("begun")
	g.load_map("a2_mill",Vector2(17,17),true)
	for e in g.enemies:e.ai_enabled=false
	g.player.set_physics_process(false)
	var water=load("res://scripts/wading.gd")
	var bank=Vector3(20.5,0,0);var waist=Vector3(22.5,0,0);var deep=Vector3(24,0,0)
	test.check(water.depth(g.current_world,bank)<water.depth(g.current_world,waist) and water.depth(g.current_world,deep)>water.SHOULDER,"Beach shelf deepens continuously past shoulder depth")
	test.check(water.speed(g.current_world,bank)>water.speed(g.current_world,waist) and water.speed(g.current_world,waist)>.25,"Wading progressively slows movement toward deep water")
	g.player.position=bank;g.player.position.y=g.current_world.ground_height(bank);g.player.velocity=Vector3.RIGHT*2;g.current_world.move_grounded(g.player,.1)
	test.check(g.player.position.x>20.5 and g.player.position.x<20.7 and g.player.position.y<-.1,"Actual player movement crosses the old shoreline barrier onto the submerged shelf")
	g.player.position=deep;g.player.position.y=g.current_world.ground_height(deep);g.player.invulnerability=99;g.toggle_inventory();g._refresh_simulation();water.tick(g)
	test.check(g.player.health>0,"Inventory pauses drowning consistently with combat")
	g.inventory.close();g._refresh_simulation();water.tick(g)
	test.check(g.player.health==0,"Shoulder-deep immersion drowns even through hurt immunity and armor")
	g.respawn_player();test.check(g.player.health==g.player.max_health and g.map_id=="a2_haven","Drowning uses the existing death and checkpoint respawn")
	g._refresh_simulation()
	g.player.set_physics_process(true)
	var growth=g.progression.snapshot();g.progression.restore({"tree_version":3,"xp":10000,"learned":[],"passives":[]})
	g.skill_tree.branch="Mana";g.skill_tree.category="all";g.skill_tree.selected_id="sea_dragon";g.skill_tree.refresh()
	test.check(g.skill_tree.cards.mana.visible and not g.skill_tree.cards.mana_lance.visible and not g.skill_tree.cards.sea_dragon.visible,"Constellation hides later unlocks and their labels until prerequisites are learned")
	g.progression.learn("mana");g.skill_tree.refresh()
	test.check(g.skill_tree.cards.mana_lance.visible and not g.skill_tree.cards.sea_dragon.visible,"Learning Mana reveals its next constellation stars only")
	g.progression.learn("mana_lance");g.skill_tree.refresh();test.check(g.skill_tree.cards.sea_dragon.visible,"Learning Lance reveals Sea Dragon without spending its point automatically")
	g.progression.restore(growth);g.skill_tree.branch="Strength";g.skill_tree.refresh()
	g.load_map("a2_belfry",Vector2(0,8),true);var boss=g.enemies[0];boss.set_physics_process(false);boss.ai_enabled=true
	g._refresh_simulation()
	g.player.set_physics_process(false);g.player.position=boss.position+Vector3(0,0,2);g.player.state="free";g.player.invulnerability=0;g.player.restore_health(g.player.max_health)
	boss.state="cleave";boss.state_time=.85;boss.direction=Vector3.BACK;boss.melee_step=0
	var hp=g.player.health;boss._physics_process(.25)
	test.check(boss.melee_step==1 and g.player.health<hp,"Guardian's first claw sweep makes real melee contact")
	g.player.invulnerability=0;hp=g.player.health;boss._physics_process(.4)
	test.check(boss.melee_step==2 and g.player.health<hp,"Guardian commits a second distinct claw hit")
	g.player.restore_health(g.player.max_health);boss.state="roots_tell";boss.state_time=1;boss.prepare_roots()
	test.check(boss.hazards.size()>=3 and boss.hazards.all(func(h):return h.marker.visible and h.spike.scale.y<.1),"Root barrage marks actual ground targets before eruption")
	g.player.position=boss.hazards[0].at;g.player.invulnerability=0;hp=g.player.health;boss.update_roots(.2)
	test.check(g.player.health<hp and boss.hazards[0].hit,"Delayed root eruption damages its marked location")
	boss.clear_roots();boss.state="rock_tell";boss.state_time=float(boss.spec.windup)*.5;boss.direction=Vector3.BACK;boss._physics_process(.01)
	test.check(boss.seed.visible and boss.seed.position.y>.3 and boss.seed.scale.x>.2,"Ranged thornseed visibly grows and lifts before launch")
	var count=g.projectiles.size();boss.state_time=.001;boss._physics_process(.01)
	test.check(g.projectiles.size()==count+1 and not g.projectiles[-1].stone.visible and not boss.seed.visible,"Guardian fires the grown thornseed instead of an instant visible boulder")
	var shot=g.projectiles[-1];shot.repel(Vector3.ZERO,0,0);shot.position=boss.position+Vector3(0,.7,.1);shot._physics_process(.001)
	test.check(boss.armor_open>0,"Returned thornseed exposes the living guardian")
	for kind in JSON.parse_string(FileAccess.get_file_as_string("res://content/alpha2_creatures.json")):
		var enemy=load("res://scripts/library_enemy.gd").new();enemy.configure({"id":"facing_check","kind":kind,"at":[0,10]},g.player);enemy.game=g;g.world_root.add_child(enemy);enemy.set_physics_process(false);enemy.simulation_enabled=true
		g.player.position=enemy.position+Vector3(1,0,0);enemy.visual.rotation.y=PI;enemy._physics_process(.001)
		test.check(enemy.state=="windup" and enemy.visual.basis.z.dot(enemy.direction)>.999,kind+": attack entry immediately faces its actual aim")
		g.player.position=enemy.position+Vector3(-1,0,0);enemy.state_time=float(enemy.spec.windup)*.8;enemy._physics_process(.001)
		var nose=Vector3.RIGHT if kind=="library_spider" else Vector3.FORWARD if kind=="library_boar" else Vector3.BACK
		test.check(enemy.direction.x<-.99 and (enemy.art.global_basis*nose).normalized().dot(enemy.direction)>.999,kind+": early windup tracks player with calibrated model front")
		var committed=enemy.direction;g.player.position=enemy.position+Vector3(1,0,0);enemy.state_time=.1;enemy._physics_process(.001);enemy.state="lunge";enemy.state_time=.4;enemy.visual.rotation.y=0;enemy._physics_process(.001)
		test.check(enemy.direction.dot(committed)>.999 and enemy.visual.basis.z.dot(committed)>.999,kind+": released attack stays aligned without homing after commitment")
		enemy.free()
	boss.simulation_enabled=true;boss.ai_enabled=true;boss.state="cleave_tell";boss.state_time=1;g.player.position=boss.position+Vector3(2,0,0);boss._physics_process(.001)
	test.check(boss.direction.x>.99 and boss.visual.basis.z.dot(boss.direction)>.999,"Bellkeeper turns its melee/ranged preparation toward the player")
	g.player.set_physics_process(true);g.alpha2_import_path=""
	g.game_mode="alpha";await load("res://scripts/menu_checks.gd").new().run(test)
