extends RefCounted
func run(test:RefCounted) -> void:
	var g=test.game;var chamber=preload("res://scripts/rise_chamber.gd")
	g.title_screen.hide();g._refresh_simulation();g.set_process(false);g.player.set_physics_process(false)
	g.load_map("wr_floor_01",chamber.return_point(),true)
	for e in g.enemies:e.set_physics_process(false);e.ai_enabled=false
	await test.frames(2)
	var entry=g.current_world.interactions.filter(func(t):return t.get("wr_chamber","")=="enter")
	test.check(entry.size()==1 and chamber.ENTRANCE.x< -150 and chamber.ENTRANCE.y< -100,"Vault entrance is hidden in far northwest Elderwood, opposite the guild")
	var toward=entry[0].position-g.player.position;toward.y=0
	for i in range(60):g.player.velocity=toward.normalized()*2.4;g.current_world.move_grounded(g.player,1.0/60)
	test.check(g.player.position.distance_to(entry[0].position)<3.2,"Actual player capsule can approach the cave threshold from the hillside")
	g.worldrise.interact(entry[0]);await test.frames(2)
	test.check(g.map_id=="wr_boss_chamber" and g.enemies.is_empty() and g.current_world.safe_position(g.player.position),"Cave interaction enters the separate empty floating boss island")
	test.check(g.current_world.has_node("ContinuousCavernWalls") and g.current_world.has_node("SlopedCavernCeiling") and g.world_root.get_node("WorldSun").light_energy==0,"Continuous enclosing walls and sloped roof use crystal light without sunlight")
	var lights=g.current_world.find_children("*","OmniLight3D",true,false)
	test.check(lights.size()>=14 and g.environment_settings.fog_density>=.0179,"Wall crystals provide real blue lights above a fog-filled void")
	g.player.position=Vector3(0,0,35)
	for i in range(300):g.player.velocity=Vector3(0,0,-5);g.current_world.move_grounded(g.player,1.0/60)
	test.check(g.player.position.z<12 and absf(g.player.position.y)<.1 and not g.player.has_meta("rise_fall"),"Actual capsule crosses the narrow arrival shelf onto the main arena")
	var path="user://vault-verification.json";var data=g.save_data()
	test.check(g.Save.write(data,path)==OK and not g.Save.read(path).is_empty() and g.apply_save(g.Save.read(path)) and g.map_id=="wr_boss_chamber","Private chamber save/load retains the area and safe island position")
	g.player.set_physics_process(false);g.set_process(false);await test.frames(2)
	g.worldrise.interact(g.current_world.interactions[0]);await test.frames(2)
	test.check(g.map_id=="wr_floor_01" and g.player.position.distance_to(Vector3(chamber.return_point().x,g.current_world.ground_height(g.player.position),chamber.return_point().y))<1 and g.world_root.get_node("WorldSun").light_energy>0,"Return cave restores Elderwood and outdoor lighting")
	g.load_map("wr_boss_chamber",Vector2(0,0),true);await test.frames(2);g.player.set_physics_process(false)
	g.player.position=Vector3(24,0,0);g.player.velocity=Vector3.ZERO
	for i in range(30):g.current_world.move_grounded(g.player,1.0/60)
	test.check(g.player.has_meta("rise_fall") and g.player.position.y< -1,"Arena edge has no invisible railing and begins a real gravity fall")
	g.player.position.y=-25;g.current_world.move_grounded(g.player,1.0/60)
	test.check(g.player.health==0 and g.death_screen.visible,"Falling through the dark mist is lethal")
	g.respawn_player();g.player.set_physics_process(false)
	test.check(g.map_id=="wr_floor_01" and g.player.health>0 and not g.player.has_meta("rise_fall"),"Vault fall respawns at the existing floor rest crystal")
	if FileAccess.file_exists(path):DirAccess.remove_absolute(path)
