extends RefCounted
func freeze(game:Node) -> void:
	game.player.set_physics_process(false)
	for enemy in game.enemies: enemy.set_physics_process(false)
func run(test:RefCounted) -> void:
	var game=test.game
	game.start_new_game(false); game.home_intro_complete=true; game.load_map("jungle_approach",Vector2(12,0),true); freeze(game)
	test.check(game.enemies.size()==4 and game.enemies.all(func(mob): return mob.state=="tree_wait" and mob.position.y>3),"Jungle route starts with four slimes visibly perched above the ground")
	var ambush=game.enemies[0]; game.player.position=Vector3(ambush.position.x,0,0); game.player.invulnerability=0; game.player.restore_health(100)
	ambush._physics_process(.01); var target=ambush.drop_target
	test.check(game.enemies.all(func(mob): return mob.state=="tree_warn"),"One canopy trigger launches all four grouped ambush slimes together")
	test.check(ambush.state=="tree_warn" and is_instance_valid(ambush.drop_warning),"Approaching the tree locks a marked landing on the player")
	game.toggle_pause(); var clock=ambush.drop_clock; ambush._physics_process(.8)
	test.check(ambush.drop_clock==clock,"Pause freezes the tree-drop warning")
	game.pause_menu.close(); game._refresh_simulation(); ambush._physics_process(.65); ambush._physics_process(.4)
	test.check(ambush.state=="tree_fall" and ambush.position.y>target.y+.5,"Tree slime actually travels through the air toward its landing")
	game.player.position=target; game.player.state="roll"; game.player.invulnerability=0; var hp=game.player.health; ambush._physics_process(.45)
	test.check(ambush.state=="recover" and game.player.health<hp,"Tree landing deals impact damage even during a roll")
	var xp=game.progression.xp; ambush.take_damage(999,Vector3.ZERO)
	test.check("jungle_approach/canopy_slime_1" in game.defeated_enemies and game.progression.xp==xp+35,"Ambush defeats persist and award their fixed slime XP once")
	game.load_map("jungle_approach",Vector2(12,0),true); freeze(game)
	test.check(game.enemies[0].health==0 and game.enemies[1].state=="tree_wait","Returning preserves defeated ambushes without disabling remaining perches")
	game.load_map("queen_arena",Vector2(7,0),true); freeze(game); game.player.state="free"; game.player.restore_health(100); game.player.invulnerability=0
	var queen=game.enemies[0]; queen.set_physics_process(false)
	test.check(queen.style=="queen_slime" and queen.max_health==650 and queen.size_class=="large","Queen is a distinct large enemy with a crown and boss-sized health")
	var height=game.current_world.ground_height(Vector3(8,0,0))
	test.check(height>.2 and game.current_world.ground_step_allowed(Vector3(8,0,0),Vector3(8.1,0,0)),"Basin has visibly raised slopes that support actual walking")
	queen._splash_brood(); var flights=game.get_tree().get_nodes_in_group("queen_brood").filter(func(node): return node is Node3D and node.has_method("repel") and not node.has_method("setup_core"))
	test.check(flights.size()==4 and flights.map(func(node): return node.entry.code).has("9E"),"Queen launches all four existing slime colors in airborne gloop")
	hp=game.player.health; game.player.invulnerability=0
	for flight in flights:
		flight.set_physics_process(false); flight._physics_process(flight.duration)
	var cores=game.get_tree().get_nodes_in_group("queen_brood").filter(func(node): return node.has_method("setup_core"))
	for core in cores: core.set_physics_process(false)
	test.check(cores.size()==4 and cores.all(func(core): return core.health==18 and core.duration==5),"Four splashes become destructible cores with exactly five seconds to hatch")
	test.check(game.player.health==hp-12,"Queen's directly aimed brood splash damages a player who stays at its landing")
	var doomed=cores[0]; doomed.take_sword_damage(30,Vector3.RIGHT,true); var before=game.enemies.size(); doomed._physics_process(5)
	test.check(doomed.health==0 and game.enemies.size()==before,"Destroying a core with the sword prevents its slime from forming")
	var core=cores[1]; var first=core.lobes[0].position; core._physics_process(2.5)
	test.check(core.lobes[0].position.length()<first.length() and core.lobes[0].scale.y>1,"Goop lobes visibly gather inward and rise toward the forming slime")
	game.toggle_inventory(); var age=core.age; core._physics_process(3)
	test.check(core.age==age,"Inventory freezes the five-second brood countdown")
	game.inventory.close(); game._refresh_simulation(); core._physics_process(2.49)
	test.check(core.health>0,"Core remains attackable just before five seconds")
	core._physics_process(.02)
	test.check(core.health==0 and game.enemies.any(func(mob): return mob.definition.get("transient",false) and mob.definition.kind=="practice" and mob.has_method("notice_trapped_target") and mob.style=="moss_slime"),"Surviving core becomes its matching slime after the full deadline")
	for mob in game.enemies: mob.set_physics_process(false)
	await test.frames(2)
	test.check(queen.living_brood()<=4,"Queen counts airborne goop, living cores and living slimes against one bounded brood cap")
	queen.attack_index=1; queen.state="idle"; queen._start_attack(); queen.ai_enabled=true
	var landing=queen.jump_target
	test.check(queen.state=="jump_warn" and is_instance_valid(queen.warning),"Queen jumping attack marks its exact landing with a warning ring")
	game.toggle_pause(); var remaining=queen.state_time; queen._physics_process(2)
	test.check(queen.state_time==remaining,"Pause freezes the queen jump wind-up")
	game.pause_menu.close(); game._refresh_simulation(); queen._physics_process(1.36); queen._physics_process(.5)
	test.check(queen.state=="queen_jump" and queen.position.y>landing.y+2,"Queen leaps high above her telegraphed landing")
	game.player.position=landing; game.player.invulnerability=0; game.player.state="free"; hp=game.player.health; queen._physics_process(.66)
	test.check(queen.state=="recover" and game.player.health==hp-28,"Queen slam lands on the slope and deals its radial damage once")
	queen.attack_index=2; queen._start_attack(); queen._physics_process(1.01)
	test.check(queen.state=="queen_charge" and not queen.dash_line.visible,"Queen releases a typical charge after its directional warning")
	game.player.set_sword_drawn(true); game.player.state="free"; game.player.restore_stamina(100); game.player.visual.rotation.y=0; game.player.begin_parry(); game.player.state_time=.3
	queen.position=game.player.position+Vector3(0,0,1.2); queen.direction=Vector3.FORWARD; queen.lunge_hit=false; queen._physics_process(.01)
	test.check(queen.state=="recover" and queen.knockback.length()>0,"Timed parry stops and repels the queen charge")
	game.player.state="free"; game.player.restore_health(100); xp=game.progression.xp; queen.take_damage(9999,Vector3.ZERO)
	test.check(game.progression.xp==xp+1200 and "queen_arena/slime_queen" in game.defeated_enemies,"Queen defeat grants 400 base plus 800 boss XP once and remains defeated")
	var file="user://queen-verification.json"; game.Save.write(game.save_data(),file)
	test.check(not game.Save.read(file).is_empty(),"New jungle and queen defeats pass private save validation")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(file))
	game.load_map("coastal_path",Vector2(0,3),true); await test.frames(2)
	test.check(game.get_tree().get_nodes_in_group("queen_brood").is_empty(),"Area travel cleans all queen projectiles, cores and transient brood")
	var pack=load("res://scripts/builder_document.gd").example(); pack.maps[0].catalog_enemies=[{"id":"drop_slime","code":"9E","at":[9,8],"spawn_mode":"tree_drop","drop_height":4,"trigger_radius":6}]
	test.check(game.WorldPacks.validate(pack).is_empty(),"Builder world files accept configurable tree-drop slime placements")
	pack.maps[0].catalog_enemies[0].code="10E"
	test.check(not game.WorldPacks.validate(pack).is_empty(),"Builder prevents invalid queen tree-drop placements")
	game.load_map("slime_forest",Vector2(-11.5,-1),true); freeze(game); game.player.state="free"; game.exit_cooldown=0; game._process(0)
	test.check(game.map_id=="jungle_approach","Actual west Slime Forest gate travels into the jungle approach")
	freeze(game); game.player.position=Vector3(-15.5,0,0); game.player.state="free"; game.exit_cooldown=0; game._process(0)
	test.check(game.map_id=="queen_arena","Actual far end of jungle trail travels into the sloped queen arena")
	game.load_map("menagery",Vector2(10,0),true); freeze(game)
	var practice=game.menagery.spawn("10E"); practice.set_physics_process(false); practice._splash_brood()
	for flight in game.get_tree().get_nodes_in_group("queen_brood").duplicate():
		flight.set_physics_process(false); flight._physics_process(flight.duration)
	game.menagery.clear(); await test.frames(2)
	test.check(game.enemies.is_empty() and game.enemy_bars.is_empty(),"Menagery Clear removes queen cores and transient brood without stale enemy bars")
	game.player.set_physics_process(true)
