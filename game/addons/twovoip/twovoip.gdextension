[configuration]
entry_symbol = "two_voip_library_init"
compatibility_minimum = "4.1.4"
reloadable = false
[libraries]
macos.release = "libs/libtwovoip.macos.template_release.universal.framework/libtwovoip.macos.template_release.universal.dylib"
macos = "libs/libtwovoip.macos.template_debug.universal.framework/libtwovoip.macos.template_debug.universal.dylib"
windows.release.x86_64 = "libs/libtwovoip.windows.template_release.x86_64.dll"
windows.x86_64 = "libs/libtwovoip.windows.template_debug.x86_64.dll"
linux.release.x86_64 = "libs/libtwovoip.linux.template_release.x86_64.so"
linux.x86_64 = "libs/libtwovoip.linux.template_debug.x86_64.so"
