; Coastal Foundation: pinned Godot 4.5.1
config_version=5

[application]
config/name="Coastal Foundation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="A reusable pixelated 3D exploration foundation."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.045, 0.075, 0.08, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
