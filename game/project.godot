; Coastal Foundation: pinned Godot 4.5.1
config_version=5

[application]
run/max_fps=60
config/name="Coastal Foundation"
config/icon="res://assets/ui/launcher-icon-v1.png"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/description="Woodland 3D exploration, advanced scanned scenery, oversized sword combat and timed parries."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.045, 0.075, 0.08, 1)
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=3

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
