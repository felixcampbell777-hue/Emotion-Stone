{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boar",
    "wisp",
    "warden"
  ],
  "properties": {
    "boar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice",
        "range",
        "speed",
        "attack_speed",
        "damage",
        "recovery",
        "health",
        "windup",
        "color"
      ],
      "properties": {
        "notice": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "range": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "attack_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "damage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "recovery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "windup": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "wisp": {
