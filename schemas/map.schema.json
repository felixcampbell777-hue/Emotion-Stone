{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "subtitle",
    "seed",
    "bounds",
    "spawn",
    "sea",
    "terrain_regions",
    "props",
    "npcs",
    "interactions",
    "exits"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "sea": {
      "type": "boolean"
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -1024,
        "maximum": 1024
      },
      "minItems": 4,
      "maxItems": 4
    },
    "spawn": {
      "$ref": "#/$defs/point"
    },
    "terrain_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rect",
          "kind"
        ],
        "properties": {
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "kind": {
            "enum": [
              "grass",
              "path",
              "sand",
              "water",
              "cobble"
            ]
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "at"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "tree",
              "house",
              "wall",
              "rock",
              "flowers",
              "bench",
              "well",
              "bed",
              "table",
              "chair",
              "cupboard",
              "hearth",
              "rug",
              "stairs",
              "door",
              "shelf",
              "catalog_feature",
              "castle_wall",
              "castle_tower",
              "castle_gate",
              "castle_keep",
              "market_stall"
            ]
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "rotation": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          },
          "variant": {
            "enum": [
              0,
              1
            ]
          },
          "length": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 20
          },
          "floors": {
            "enum": [
              1,
              2
            ]
          },
          "catalog_code": {
            "type": "string",
            "pattern": "^[1-9][0-9]*[ABCDFG]$"
          },
          "show_label": {
            "type": "boolean"
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "character",
          "at",
          "dialogue"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "character": {
            "$ref": "#/$defs/id"
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "dialogue": {
            "$ref": "#/$defs/lines"
          },
          "role": {
            "enum": [
              "mother",
              "farm_parent",
              "farm_partner",
              "farm_child",
              "a2_mother",
              "a2_mara",
              "a2_ada",
              "a2_oren",
              "a2_jun",
              "a2_sable",
              "a2_sable_chapel"
            ]
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "at",
          "title",
          "lines"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "sign",
              "well"
            ]
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "title": {
            "type": "string"
          },
          "lines": {
            "$ref": "#/$defs/lines"
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rect",
          "target",
          "spawn",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "target": {
            "$ref": "#/$defs/id"
          },
          "spawn": {
            "$ref": "#/$defs/point"
          },
          "label": {
            "type": "string"
          },
          "interact": {
            "type": "boolean"
          }
        }
      }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "at"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "slime",
              "boar",
              "wisp",
              "warden",
              "goblin_raider",
              "goblin_guard",
              "goblin_slinger",
              "goblin_foreman",
              "beta_wolf",
              "beta_rat",
              "bellkeeper",
              "library_crab",
              "library_sentinel",
              "library_spider",
              "library_boar",
              "library_wolf",
              "library_rat",
              "canyon_fiend",
              "vault_elder",
              "beta_twin_wolf"
            ]
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "size": {
            "enum": [
              "small",
              "medium",
              "large",
              "giant"
            ]
          },
          "pack": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "interior": {
      "enum": [
        "bedroom",
        "hearth"
      ]
    },
    "cave": {
      "type": "boolean"
    },
    "catalog_enemies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "at"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "code": {
            "type": "string"
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "spawn_mode": {
            "enum": [
              "ground",
              "tree_drop"
            ]
          },
          "drop_height": {
            "type": "number",
            "minimum": 2,
            "maximum": 8
          },
          "trigger_radius": {
            "type": "number",
            "minimum": 2,
            "maximum": 12
          },
          "ambush_group": {
            "type": "string",
            "maxLength": 48
          },
          "respawn_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          }
        }
      }
    },
    "biome": {
      "enum": [
        "woodland",
        "jungle",
        "beach",
        "highlands"
      ]
    },
    "sculpted_terrain": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "height",
          "radius",
          "profile"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "height": {
            "type": "number",
            "minimum": -6,
            "maximum": 10
          },
          "radius": {
            "type": "number",
            "minimum": 1,
            "maximum": 16
          },
          "rotation": {
            "type": "number"
          },
          "profile": {
            "enum": [
              "smooth",
              "bluff",
              "overhang"
            ]
          },
          "plateau_width": {
            "type": "number",
            "minimum": 1
          },
          "plateau_depth": {
            "type": "number",
            "minimum": 1
          },
          "edge_roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.7
          }
        }
      }
    },
    "wading": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -512,
        "maximum": 512
      }
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      },
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
