{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["id", "display_name", "subtitle", "seed", "bounds", "spawn", "sea", "terrain_regions", "props", "npcs", "interactions", "exits"],
  "properties": {
    "id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1}, "subtitle": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0}, "sea": {"type": "boolean"},
    "bounds": {"type": "array", "items": {"type": "integer", "minimum": -100, "maximum": 100}, "minItems": 4, "maxItems": 4},
    "spawn": {"$ref": "#/$defs/point"},
    "terrain_regions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["rect", "kind"],
      "properties": {"rect": {"$ref": "#/$defs/rect"}, "kind": {"enum": ["grass", "path", "sand", "water"]}}
    }},
    "props": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["tree", "house", "wall", "rock", "flowers", "bench", "well"]}, "at": {"$ref": "#/$defs/point"},
        "rotation": {"type": "number"}, "scale": {"type": "number", "minimum": 0.1, "maximum": 4}, "variant": {"enum": [0,1]}, "length": {"type": "number", "minimum": 0.2, "maximum": 20}
      }
    }},
    "npcs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "character", "at", "dialogue"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "character": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/point"}, "dialogue": {"$ref": "#/$defs/lines"}}
    }},
    "interactions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "at", "title", "lines"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "sign"}, "at": {"$ref": "#/$defs/point"}, "title": {"type": "string"}, "lines": {"$ref": "#/$defs/lines"}}
    }},
    "exits": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "rect", "target", "spawn", "label"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "rect": {"$ref": "#/$defs/rect"}, "target": {"$ref": "#/$defs/id"}, "spawn": {"$ref": "#/$defs/point"}, "label": {"type": "string"}}
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -100, "maximum": 100}},
    "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}, "prefixItems": [{"type": "number"},{"type": "number"},{"type": "number", "exclusiveMinimum": 0},{"type": "number", "exclusiveMinimum": 0}]},
    "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
