{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quest_xp",
    "secret_xp",
    "speed_bonus",
    "enemies",
    "actions",
    "ambushes"
  ],
  "properties": {
    "quest_xp": {
      "type": "integer",
      "minimum": 1
    },
    "secret_xp": {
      "type": "integer",
      "minimum": 1
    },
    "speed_bonus": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "enemies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goblin_raider",
        "goblin_guard",
        "goblin_slinger",
        "goblin_foreman"
      ],
      "properties": {
        "goblin_raider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "damage",
            "speed",
            "windup",
            "lunge_speed",
            "recovery"
          ],
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "speed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "windup": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 4
            },
            "lunge_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "recovery": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 5
            }
          }
        },
        "goblin_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "damage",
            "speed",
            "windup",
            "lunge_speed",
            "recovery"
          ],
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "speed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "windup": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 4
            },
            "lunge_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "recovery": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 5
            }
          }
        },
        "goblin_slinger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "damage",
            "speed",
            "windup",
            "lunge_speed",
            "recovery"
          ],
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "speed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "windup": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 4
            },
            "lunge_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "recovery": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 5
            }
          }
        },
        "goblin_foreman": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "damage",
            "speed",
            "windup",
            "lunge_speed",
            "recovery"
          ],
          "properties": {
            "health": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "speed": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "windup": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 4
            },
            "lunge_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "recovery": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 5
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "map",
          "type",
          "at",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "map": {
            "type": "string"
          },
          "type": {
            "enum": [
              "gate",
              "lever",
              "alarm",
              "barricade",
              "secret_wall",
              "goods",
              "heirloom",
              "charm",
              "rest",
              "shortcut",
              "return_shortcut"
            ]
          },
          "at": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "ambushes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "map",
          "at",
          "radius",
          "enemies"
        ],
        "properties": {
          "id": {
            "enum": [
              "ambush_road",
              "ambush_cave"
            ]
          },
          "map": {
            "type": "string"
          },
          "at": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          },
          "radius": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 8
          },
          "enemies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
