{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cores",
    "profiles",
    "beasts"
  ],
  "properties": {
    "cores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "family",
          "healing_percent",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "family": {
            "enum": [
              "slime",
              "goblin",
              "spore",
              "spirit",
              "boss"
            ]
          },
          "healing_percent": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "drop_rate",
          "generic",
          "variant",
          "variant_chance",
          "boss_bonus"
        ],
        "properties": {
          "drop_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "generic": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "variant_chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "boss_bonus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "beasts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
